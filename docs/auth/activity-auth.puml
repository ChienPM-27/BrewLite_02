@startuml activity-auth
title Sơ Đồ Hoạt Động - Quy Trình Xác Thực Người Dùng (Auth Flow)

skinparam nodesep 12
skinparam ranksep 16
skinparam defaultFontSize 11
skinparam activityFontSize 11
skinparam arrowFontSize 10
skinparam wrapWidth 220

skinparam backgroundColor white
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor black

start

:Khách hàng truy cập màn hình Xác thực;

if (Chọn hành động?) then (Đăng ký mới)
    :Nhập email, password (>= 6 ký tự), họ tên;
    :Gửi request POST /api/v1/auth/register;
    :Backend ValidationPipe kiểm tra cú pháp DTO;
    
    if (Email đã tồn tại trong CSDL?) then (Đã tồn tại)
        :Ném lỗi 409 Conflict\n("Email này đã được sử dụng");
        :Giao diện hiển thị banner thông báo lỗi;
        stop
    else (Chưa có)
        :Băm mật khẩu an toàn (bcrypt, salt = 10);
        :Tạo bản ghi User mới trong PostgreSQL;
    endif

else (Đăng nhập)
    :Nhập email và mật khẩu tài khoản;
    :Gửi request POST /api/v1/auth/login;
    :Backend ValidationPipe kiểm tra định dạng DTO;
    :Truy vấn User theo email trong CSDL;
    
    if (User tồn tại và đúng mật khẩu?) then (Sai thông tin)
        :Ném lỗi 401 Unauthorized\n("Email hoặc mật khẩu không chính xác");
        :Giao diện hiển thị lỗi đăng nhập thất bại;
        stop
    else (Hợp lệ)
    endif
endif

:Backend ký phát hành JSON Web Token (JWT)\n(payload: sub=userId, email, exp=7 ngày);
:Đóng gói phản hồi HTTP 200/201 kèm accessToken & thông tin User;
:Frontend lưu Token vào LocalStorage & Zustand useAuthStore;
:Cập nhật trạng thái đăng nhập trên Navbar (hiển thị họ tên);
:Điều hướng người dùng về trang trước đó (hoặc /menu);

stop
@enduml
