@startuml
title Activity Diagram: Quản lý giỏ hàng

|Khách hàng|
start
:Mở giao diện Giỏ hàng;

|Frontend (Zustand)|
:Đọc trạng thái Giỏ hàng (Local State);
if (Giỏ hàng trống?) then (Có)
  :Hiển thị màn hình Empty State;
  :Vô hiệu hóa nút "Thanh toán";
  stop
else (Không)
  :Hiển thị danh sách món (Size, Topping);
  :Tính và hiển thị Tổng tiền & Badge;
endif

|Khách hàng|
repeat
  :Thực hiện thay đổi (Thêm/Sửa/Xóa món);
  |Frontend (Zustand)|
  :Cập nhật State nội bộ;
  :Tính lại Tổng tiền (basePrice + sizePrice + toppingPrice);
repeat while (Tiếp tục chỉnh sửa?) is (Có)

|Khách hàng|
:Nhấn nút "Thanh toán";

|Frontend (Zustand)|
:Bật Loading State;
:Gửi payload gọi API POST /api/v1/orders;

|Backend (NestJS)|
:Tiếp nhận Request;
:Kiểm tra Class-validator (Định dạng, qty >= 1);
if (Dữ liệu hợp lệ?) then (Không)
  :Trả lỗi 400 Bad Request (Lỗi đầu vào);
else (Có)
  :Truy vấn DB (Product, ProductSizePrice, Topping);
  :Kiểm tra isAvailable và Stock (Tồn kho);
  :Đối chiếu giá tiền hiện tại;
  
  if (Đủ tồn kho & Khớp giá?) then (Không)
    :Hủy tạo đơn;
    :Trả lỗi 400 kèm dữ liệu thực tế (Giá mới, Stock mới);
  else (Có)
    :Tạo bản ghi vào bảng Order (Trạng thái PENDING);
    :Tạo bản ghi vào OrderItem & OrderItemTopping;
    :Trả về mã orderId;
  endif
endif

|Frontend (Zustand)|
if (Kết quả trả về) then (Thành công)
  :Tắt Loading;
  :Clear dữ liệu Giỏ hàng (Làm rỗng Zustand);
  :Chuyển hướng sang trang Thanh toán (kèm orderId);
  stop
else (Lỗi)
  :Tắt Loading;
  :Cập nhật lại State Giỏ hàng bằng dữ liệu Backend gửi;
  :Hiển thị Error State (Cảnh báo đỏ: Hết hàng/Sai giá);
  |Khách hàng|
  :Xem lại cảnh báo và điều chỉnh Giỏ hàng;
  detach
endif
@enduml