@startuml
left to right direction
skinparam Maincolor #0052cc
skinparam Backgroundcolor transparent

actor "Khách hàng" as Client

rectangle "Quản lý giỏ hàng (cart)" {
  usecase "Xem Giỏ hàng" as UC_View
  usecase "Thay đổi Size / Topping / Số lượng" as UC_Edit
  usecase "Xóa món khỏi giỏ" as UC_Remove
  usecase "Cập nhật Tổng tiền & Badge" as UC_Calc
  
  usecase "Đặt hàng (POST /orders)" as UC_Checkout
  usecase "Xác thực Đăng nhập" as UC_Auth
  usecase "Kiểm tra Tồn kho & Giá" as UC_Validate
  usecase "Cảnh báo mất đồng bộ dữ liệu" as UC_Error
}

Client --> UC_View
Client --> UC_Edit
Client --> UC_Remove
Client --> UC_Checkout

UC_Edit ..> UC_Calc : <<include>>
UC_Remove ..> UC_Calc : <<include>>

UC_Checkout ..> UC_Validate : <<include>>
UC_Checkout ..> UC_Auth : <<include>>

UC_Error ..> UC_Checkout : <<extend>>
note bottom of UC_Error : Xảy ra khi DB báo hết hàng,\nsai giá hoặc lỗi class-validator

@enduml
