@startuml sequence-auth
title Sequence Diagram - Toàn Diện Xác Thực Auth (Register, Login & JwtAuthGuard)
autonumber
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Khách hàng (User)" as User
box "Frontend (Next.js)" #F9F9F9
    participant "Page / Component\n(app/auth/..., app/checkout/...)" as Page
    participant "Zustand: useAuthStore\n(store/useAuthStore.ts)" as Store
    participant "Client: API Service\n(services/auth.service.ts, order.service.ts)" as ClientService
end box

box "Backend (NestJS)" #F0F7FF
    participant "Guard: JwtAuthGuard\n(modules/auth/guards/jwt-auth.guard.ts)" as Guard
    participant "Strategy: JwtStrategy\n(modules/auth/strategies/jwt.strategy.ts)" as Strategy
    participant "Controller: AuthController / OrdersController\n(modules/auth/..., modules/orders/...)" as Controller
    participant "Service: AuthService / OrdersService\n(modules/auth/..., modules/orders/...)" as Service
    participant "Security: bcrypt & JwtService\n(@nestjs/jwt, bcrypt)" as Crypto
    participant "Database: PrismaService\n(prisma/prisma.service.ts)" as DB
end box

== Luồng 1: Đăng Ký Tài Khoản (Register) ==
User -> Page: Nhập email, password, fullName & nhấn "Đăng ký"
activate Page
Page -> ClientService: registerApi({ email, password, fullName })
activate ClientService
ClientService -> Controller: POST /api/v1/auth/register (RegisterDto)
activate Controller
Controller -> Service: register(dto)
activate Service

Service -> DB: prisma.user.findUnique({ where: { email } })
activate DB
DB --> Service: Kết quả tìm kiếm
deactivate DB

alt Email đã được sử dụng
    Service --> Controller: throw ConflictException('Email này đã được sử dụng')
    Controller --> ClientService: 409 Conflict: { success: false, message: "Email này đã được sử dụng" }
    ClientService --> Page: Ném ApiError(409)
    Page --> User: Hiển thị banner lỗi "Email này đã được sử dụng"
else Email chưa tồn tại (Hợp lệ)
    Service -> Crypto: bcrypt.hash(dto.password, 10)
    activate Crypto
    Crypto --> Service: passwordHash (saltRounds = 10)
    deactivate Crypto

    Service -> DB: prisma.user.create({\n  data: { email, passwordHash, fullName, loyaltyPoints: 0 }\n})
    activate DB
    DB --> Service: user record (id, email, fullName, loyaltyPoints)
    deactivate DB

    Service -> Crypto: jwtService.signAsync({ sub: user.id, email: user.email })
    activate Crypto
    Crypto --> Service: accessToken
    deactivate Crypto

    Service --> Controller: { accessToken, user: { id, email, fullName, loyaltyPoints } }
    deactivate Service

    Controller --> ClientService: 201 Created: { success: true, statusCode: 201, data: { accessToken, user } }
    deactivate Controller

    ClientService --> Page: AuthResponse
    deactivate ClientService

    Page -> Store: login(res.accessToken, res.user)
    activate Store
    Store -> Store: localStorage.setItem('token', token)
    Store --> Page: State updated
    deactivate Store

    Page --> User: router.replace(next || '/menu')
    deactivate Page
end

== Luồng 2: Đăng Nhập (Login) ==
User -> Page: Nhập email, password & nhấn "Đăng nhập"
activate Page
Page -> ClientService: loginApi({ email, password })
activate ClientService
ClientService -> Controller: POST /api/v1/auth/login (LoginDto)
activate Controller
Controller -> Service: login(dto)
activate Service

Service -> DB: prisma.user.findUnique({ where: { email } })
activate DB
DB --> Service: Kết quả tìm kiếm user
deactivate DB

alt Không tìm thấy user với email cung cấp
    Service --> Controller: throw UnauthorizedException('Email hoặc mật khẩu không chính xác')
    Controller --> ClientService: 401 Unauthorized: { success: false, message: "Email hoặc mật khẩu không chính xác" }
    ClientService --> Page: Ném ApiError(401)
    Page --> User: Hiển thị banner lỗi "Email hoặc mật khẩu không chính xác"
else Tìm thấy user
    Service -> Crypto: bcrypt.compare(dto.password, user.passwordHash)
    activate Crypto
    Crypto --> Service: isValid (boolean)
    deactivate Crypto

    alt Mật khẩu không trùng khớp (isValid === false)
        Service --> Controller: throw UnauthorizedException('Email hoặc mật khẩu không chính xác')
        Controller --> ClientService: 401 Unauthorized: { success: false, message: "Email hoặc mật khẩu không chính xác" }
        ClientService --> Page: Ném ApiError(401)
        Page --> User: Hiển thị banner lỗi "Email hoặc mật khẩu không chính xác"
    else Mật khẩu hợp lệ (isValid === true)
        Service -> Crypto: jwtService.signAsync({ sub: user.id, email: user.email })
        activate Crypto
        Crypto --> Service: accessToken
        deactivate Crypto

        Service --> Controller: { accessToken, user: { id, email, fullName, loyaltyPoints } }
        deactivate Service

        Controller --> ClientService: 200 OK: { success: true, statusCode: 200, data: { accessToken, user } }
        deactivate Controller

        ClientService --> Page: AuthResponse
        deactivate ClientService

        Page -> Store: login(res.accessToken, res.user)
        activate Store
        Store -> Store: localStorage.setItem('token', token)
        Store --> Page: State updated
        deactivate Store

        Page --> User: router.replace(next || '/menu')
        deactivate Page
    end
end

== Luồng 3: Xác Thực JWT Qua JwtAuthGuard Bảo Vệ Tuyến API (Protected Routes) ==
User -> Page: Thao tác yêu cầu xác thực (ví dụ: Nhấn "Xác nhận đặt hàng")
activate Page
Page -> ClientService: createOrder(dto)
activate ClientService

ClientService -> Guard: POST /api/v1/orders\nHeaders: Authorization: Bearer <accessToken>
activate Guard

Guard -> Strategy: ExtractJwt & Passport verification\n(Kiểm tra JWT_SECRET & hạn dùng JWT_EXPIRATION)
activate Strategy

alt Token không tồn tại, hết hạn hoặc sai chữ ký
    Strategy --> Guard: Verification failure
    Guard --> Controller: Chặn request, ném UnauthorizedException
    Controller --> ClientService: 401 Unauthorized: {\n  success: false,\n  statusCode: 401,\n  message: "Vui lòng đăng nhập để tiếp tục",\n  path: "/api/v1/orders"\n}
    ClientService --> Page: Ném ApiError(401)
    Page --> User: Chuyển hướng về trang đăng nhập (/auth/login?next=/checkout)
else Token hợp lệ
    Strategy -> Strategy: validate(payload: JwtPayload)\nKiểm tra { sub, email }
    Strategy --> Guard: return { sub: payload.sub, email: payload.email }
    deactivate Strategy

    Guard -> Controller: Gắn req.user = { sub: userId, email }\nChuyển tiếp request vào OrdersController.create()
    deactivate Guard
    activate Controller

    Controller -> Service: create(req.user.sub, dto)
    activate Service
    Service -> DB: Thực thi nghiệp vụ tạo đơn hàng gắn với userId
    activate DB
    DB --> Service: newOrder record (#1042)
    deactivate DB
    Service --> Controller: newOrder
    deactivate Service

    Controller --> ClientService: 201 Created: { success: true, statusCode: 201, data: newOrder }
    deactivate Controller

    ClientService --> Page: OrderDetail
    deactivate ClientService
    Page --> User: Điều hướng sang trang Thanh toán (/checkout/payment?orderId=...)
    deactivate Page
end

@enduml